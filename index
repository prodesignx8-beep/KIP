    function formatMsgFrontend(rep, range) {
      let template = cachedSettings.TEMPLATE_PESAN || '*LAPORAN KINERJA ({periode})*\nNama: *{nama}*\nDivisi: {divisi}\nSkor Akhir: *{skor}%* ({status})';
      template = template.replace(/%0A/g, '\n');
      return template
        .replace(/{nama}/g, rep.Nama)
        .replace(/{divisi}/g, rep.Divisi)
        .replace(/{periode}/g, range)
        .replace(/{skor_kpi}/g, rep.Total_Skor_KPI)
        .replace(/{skor_kompetensi}/g, rep.Skor_Kompetensi)
        .replace(/{skor}/g, rep.Skor_Akhir)
        .replace(/{status}/g, rep.Status_Label);
    }

