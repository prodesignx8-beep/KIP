        return { success: true, message: `[Simulasi ${channel}] Rapor ${range} untuk ${u ? u.Nama : id} siap dikirim.` };
      },
      sendBulkReport(filters, channel) {
        const analytics = this.getDashboardAnalytics(filters);
        const reports = analytics.employeeReports;
        if (reports.length === 0) return { success: false, message: 'Tidak ada karyawan yang cocok dengan filter.', logs: [] };
        const logs = reports.map(r => `[SUKSES] ${channel} ke ${r.Nama} (${r.ID_Karyawan}) - Simulasi Selesai.`);
        return { success: true, message: `Berhasil memproses pengiriman ke ${reports.length} karyawan via ${channel}.`, logs: logs };
      },
      getDashboardAnalytics(filters) {
        const bobotKPI = Number(mockDB.settings.BOBOT_KPI || 70) / 100;
        const bobotKomp = Number(mockDB.settings.BOBOT_KOMPETENSI || 30) / 100;
        let targetUsers = mockDB.users.filter(u => u.Role !== 'Super Admin');
        if (filters.divisi && filters.divisi !== 'ALL') targetUsers = targetUsers.filter(u => u.Divisi === filters.divisi);
        if (filters.idKaryawan && filters.idKaryawan !== 'ALL') targetUsers = targetUsers.filter(u => u.ID_Karyawan === filters.idKaryawan);

        const validRealisasi = mockDB.realisasi.filter(r => r.Status_Validasi === 'Approved');
        const employeeReports = targetUsers.map(user => {
          const uKPIs = mockDB.masterKPI.filter(k => k.ID_Karyawan === user.ID_Karyawan);
          let totalSkorKPI = 0;
          const kpiDetails = uKPIs.map(kpi => {
            const logs = validRealisasi.filter(r => r.KPI_ID === kpi.KPI_ID);
            const aktual = (kpi.Satuan === '%' || kpi.Polaritas === 'Minimize')
              ? (logs.length ? Number(logs[logs.length - 1].Nilai_Realisasi) : 0)
              : logs.reduce((s, x) => s + Number(x.Nilai_Realisasi), 0);
            let pct = 0;
            if (logs.length) {
              pct = kpi.Polaritas === 'Minimize' ? (aktual <= kpi.Target ? 100 : (kpi.Target / aktual) * 100) : (aktual / kpi.Target) * 100;
            }
            pct = Math.min(120, Number(pct.toFixed(1)));
            totalSkorKPI += (pct * Number(kpi.Bobot)) / 100;
            return { ...kpi, Aktual: aktual, PencapaianPct: pct };
          });
          totalSkorKPI = Number(totalSkorKPI.toFixed(2));
          const uKomp = mockDB.kompetensi.filter(k => k.ID_Karyawan === user.ID_Karyawan);
          const skorKomp = uKomp.length ? Number(uKomp[uKomp.length - 1].Skor_Konversi_100) : 0;
          const skorAkhir = Number(((totalSkorKPI * bobotKPI) + (skorKomp * bobotKomp)).toFixed(2));
          const statusColor = skorAkhir >= 90 ? 'green' : (skorAkhir >= 70 ? 'yellow' : 'red');
          const statusLabel = skorAkhir >= 90 ? 'Tercapai / Sangat Baik' : (skorAkhir >= 70 ? 'Cukup' : 'Kurang');
          return {
            ...user, Total_Skor_KPI: totalSkorKPI, Skor_Kompetensi: skorKomp,
            Skor_Akhir: skorAkhir, Status_Color: statusColor, Status_Label: statusLabel, KPI_Details: kpiDetails
          };
        });

        const divMap = {};
        employeeReports.forEach(r => {
          if (!divMap[r.Divisi]) divMap[r.Divisi] = { total: 0, count: 0 };
          divMap[r.Divisi].total += r.Skor_Akhir;
          divMap[r.Divisi].count += 1;
        });
        const divisionSummary = Object.keys(divMap).map(d => ({ divisi: d, rataRataSkor: Number((divMap[d].total / divMap[d].count).toFixed(2)) }));
        const overallScore = employeeReports.length ? Number((employeeReports.reduce((s, r) => s + r.Skor_Akhir, 0) / employeeReports.length).toFixed(2)) : 0;
        return { overallScore, totalEmployees: employeeReports.length, divisionSummary, employeeReports, rangeType: filters.rangeType };
      }
    };

    // Universal Runner: Otomatis pakai fetch() jika URL Apps Script diisi, atau Mock jika kosong
    const createRunner = (onSuccess, onFailure) => new Proxy({}, {
      get(_, prop) {
        if (prop === 'withSuccessHandler') return fn => createRunner(fn, onFailure);
        if (prop === 'withFailureHandler') return fn => createRunner(onSuccess, fn);
        return async (...args) => {
          const webAppUrl = GAS_WEB_URL;
          if (webAppUrl && webAppUrl.startsWith('http')) {
            try {
              const response = await fetch(webAppUrl, {
                method: 'POST',
                headers: { 'Content-Type': 'text/plain;charset=utf-8' }, // text/plain menghindari CORS preflight di GAS
                body: JSON.stringify({ action: prop, args: args })
              });
              const json = await response.json();
              if (json.success) {
                if (onSuccess) onSuccess(json.data);
              } else {
                hideLoader();
                showToast('Error Server: ' + json.error);
                if (onFailure) onFailure(new Error(json.error));
              }
            } catch (err) {
              hideLoader();
              showToast('Gagal terhubung ke URL Apps Script! Pastikan akses diset ke "Anyone".');
              if (onFailure) onFailure(err);
            }
          } else {
            // Fallback ke Mode Demo Lokal jika URL kosong
            setTimeout(() => {
              try {
                const res = mockHandlers[prop](...args);
                if (onSuccess) onSuccess(res);
              } catch (err) {
                if (onFailure) onFailure(err);
              }
            }, 200);
          }
        };
      }
    });

