      };

      showLoader('Menyimpan nilai kompetensi...');
      google.script.run.withSuccessHandler(res => {
        hideLoader();
        showToast(res.message);
        loadKompetensiTab();
      }).savePenilaianKompetensi(payload);
    }

    // ==================== 5. MANAJEMEN USERS ====================
    function loadUsersTab() {
      showLoader('Memuat daftar karyawan...');
      google.script.run.withSuccessHandler(users => {
        hideLoader();
        allUsersCache = users;
        const tbody = document.getElementById('table-users-body');
        tbody.innerHTML = '';
        users.forEach(u => {
          tbody.innerHTML += `
            <tr class="hover:bg-slate-50 transition">
              <td class="p-3 font-medium">${u.Nama}<br><span class="text-xs text-slate-400">${u.ID_Karyawan}</span></td>
              <td class="p-3 text-xs"><span class="font-semibold text-blue-600">${u.Role}</span><br>${u.Divisi}</td>
              <td class="p-3 text-xs text-slate-600">WA: ${u.No_WA || '-'}<br>TG: ${u.Chat_ID_Telegram || '-'}<br>Email: ${u.Email || '-'}</td>
              <td class="p-3 text-right">
                <button onclick="editUser('${u.ID_Karyawan}')" class="text-blue-600 hover:text-blue-800 text-xs font-bold mr-3 border border-blue-200 px-2 py-1 rounded bg-blue-50">Edit</button>
                <button onclick="removeUser('${u.ID_Karyawan}')" class="text-red-600 hover:text-red-800 text-xs font-bold border border-red-200 px-2 py-1 rounded bg-red-50">Hapus</button>
              </td>
            </tr>
          `;
        });
      }).getAllUsers();
    }

    function editUser(id) {
      const u = allUsersCache.find(x => x.ID_Karyawan === id);
      if(!u) return;
      
      const idInput = document.getElementById('usr-id');
      idInput.value = u.ID_Karyawan;
      idInput.readOnly = true;
      idInput.classList.add('bg-slate-100', 'cursor-not-allowed', 'text-slate-500');
      
      document.getElementById('usr-nama').value = u.Nama;
      document.getElementById('usr-role').value = u.Role;
      document.getElementById('usr-divisi').value = u.Divisi;
      document.getElementById('usr-wa').value = u.No_WA || '';
      document.getElementById('usr-tg').value = u.Chat_ID_Telegram || '';
      document.getElementById('usr-email').value = u.Email || '';
      document.getElementById('usr-pass').value = ''; 
      
      document.getElementById('btn-reset-user').classList.remove('hidden');
      document.getElementById('btn-submit-user').classList.remove('col-span-2');
      document.getElementById('btn-submit-user').innerText = 'Perbarui Pengguna';
      
      // Auto-scroll ke form (terutama untuk HP)
      document.getElementById('tab-users').scrollIntoView({ behavior: 'smooth' });
    }

    function resetUserForm() {
      const idInput = document.getElementById('usr-id');
      idInput.readOnly = false;
      idInput.classList.remove('bg-slate-100', 'cursor-not-allowed', 'text-slate-500');
      
      document.getElementById('form-user').reset();
      document.getElementById('btn-reset-user').classList.add('hidden');
      document.getElementById('btn-submit-user').classList.add('col-span-2');
      document.getElementById('btn-submit-user').innerText = 'Simpan Pengguna';
    }

    function submitUser(e) {
      e.preventDefault();
      const payload = {
        ID_Karyawan: document.getElementById('usr-id').value,
        Password: document.getElementById('usr-pass').value,
        Nama: document.getElementById('usr-nama').value,
        Role: document.getElementById('usr-role').value,
        Divisi: document.getElementById('usr-divisi').value,
        No_WA: document.getElementById('usr-wa').value,
        Chat_ID_Telegram: document.getElementById('usr-tg').value,
        Email: document.getElementById('usr-email').value
      };
      showLoader('Menyimpan pengguna...');
      google.script.run.withSuccessHandler(res => {
        hideLoader();
        showToast(res.message);
        resetUserForm(); // Kembalikan form ke state awal setelah sukses
        loadUsersTab();
      }).saveUser(payload);
    }

    function removeUser(id) {
      showConfirm('Hapus pengguna ini?', () => {
        showLoader('Menghapus pengguna...');
        google.script.run.withSuccessHandler(res => {
          hideLoader();
          showToast(res.message);
          loadUsersTab();
        }).deleteUser(id);
      });
    }

    // ==================== 6. SETTINGS API ====================
    function loadSettingsTab() {
      showLoader('Memuat konfigurasi API...');
      google.script.run.withSuccessHandler(s => {
        hideLoader();
        document.getElementById('set-tg-token').value = s.TELEGRAM_BOT_TOKEN || '';
        document.getElementById('set-tg-group').value = s.TELEGRAM_GROUP_ID || '';
        document.getElementById('set-wa-url').value = s.WA_API_URL || '';
        document.getElementById('set-wa-key').value = s.WA_API_KEY || '';
        document.getElementById('set-wa-group').value = s.WA_GROUP_ID || '';
        document.getElementById('set-bobot-kpi').value = s.BOBOT_KPI || 70;
        document.getElementById('set-bobot-komp').value = s.BOBOT_KOMPETENSI || 30;
        document.getElementById('set-template').value = (s.TEMPLATE_PESAN || '').replace(/%0A/g, '\n');
      }).getSettingsAPI();
    }

    function submitSettings(e) {
      e.preventDefault();
      const payload = {
        TELEGRAM_BOT_TOKEN: document.getElementById('set-tg-token').value,
        TELEGRAM_GROUP_ID: document.getElementById('set-tg-group').value,
        WA_API_URL: document.getElementById('set-wa-url').value,
        WA_API_KEY: document.getElementById('set-wa-key').value,
        WA_GROUP_ID: document.getElementById('set-wa-group').value,
        BOBOT_KPI: document.getElementById('set-bobot-kpi').value,
        BOBOT_KOMPETENSI: document.getElementById('set-bobot-komp').value,
        TEMPLATE_PESAN: document.getElementById('set-template').value
      };
      showLoader('Menyimpan konfigurasi...');
      google.script.run.withSuccessHandler(res => {
        hideLoader();
        showToast(res.message);
      }).saveSettingsAPI(payload);
    }
  </script>
</body>
</html>
