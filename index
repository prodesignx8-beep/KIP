    function downloadPDF() {
      const modal = document.getElementById('modal-rapor');
      const modalBox = modal.children[0]; // Container putih modal
      const printArea = document.getElementById('print-area');
      
      // 1. MANIPULASI DOM SEMENTARA
      // Hapus sifat flexbox centering dari modal yang membuat html2canvas bingung (penyebab miring)
      modal.classList.remove('items-center', 'justify-center', 'flex');
      modal.classList.add('block');
      
      // Hapus batasan tinggi agar PDF ter-capture penuh dari atas ke bawah (tidak terpotong)
      modalBox.classList.remove('max-h-[90vh]', 'overflow-hidden');
      printArea.classList.remove('overflow-y-auto', 'flex-1');
      
      // Tetapkan proporsi lebar aman A4
      modalBox.style.width = '800px';
      modalBox.style.maxWidth = '100%';

      const namaLengkap = document.getElementById('pdf-nama').innerText.split(' (')[0];
      const periode = document.getElementById('pdf-periode').innerText.replace('Periode: ', '').trim();
      const fileName = `Rapor_Kinerja_${namaLengkap.replace(/\s+/g, '_')}_${periode}.pdf`;

      const opt = {
        margin:       10, 
        filename:     fileName,
        image:        { type: 'jpeg', quality: 1.0 },
        html2canvas:  { 
          scale: 2, 
          useCORS: true,
          scrollY: 0, 
          scrollX: 0
        },
        jsPDF:        { unit: 'mm', format: 'a4', orientation: 'portrait' }
      };

      showLoader('Mengekspor ke PDF...');

      html2pdf().set(opt).from(printArea).save().then(() => {
        // 2. KEMBALIKAN CSS KE SEMULA (RESTORE)
        modal.classList.add('flex', 'items-center', 'justify-center');
        modal.classList.remove('block');
        
        modalBox.classList.add('max-h-[90vh]', 'overflow-hidden');
        printArea.classList.add('overflow-y-auto', 'flex-1');
        modalBox.style.width = '';
        modalBox.style.maxWidth = '';
        
        hideLoader();
        showToast('PDF berhasil diunduh!');
      }).catch(err => {
        // Pastikan layout dikembalikan walau terjadi error
        modal.classList.add('flex', 'items-center', 'justify-center');
        modal.classList.remove('block');
        modalBox.classList.add('max-h-[90vh]', 'overflow-hidden');
        printArea.classList.add('overflow-y-auto', 'flex-1');
        modalBox.style.width = '';
        modalBox.style.maxWidth = '';
        
        hideLoader();
        showToast('Terjadi kesalahan saat mengunduh PDF.');
        console.error(err);
      });
    }

