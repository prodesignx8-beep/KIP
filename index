<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>MyKinerja Cloud - Performance & KPI Management</title>
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Chart.js CDN -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>
  <!-- html2pdf CDN untuk eksport PDF -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
  <style>
    @media print {
      body * { visibility: hidden; }
      #modal-rapor, #modal-rapor > div, #print-area, #print-area * { visibility: visible; }
      #modal-rapor {
        position: absolute !important;
        left: 0 !important;
        top: 0 !important;
        width: 100% !important;
        margin: 0 !important;
        padding: 0 !important;
        background: white !important;
        align-items: flex-start !important;
      }
      #modal-rapor > div {
        box-shadow: none !important;
        border-radius: 0 !important;
        max-width: none !important;
        width: 100% !important;
      }
      #print-area {
        position: relative !important;
        width: 100% !important;
        padding: 0 !important;
        overflow: visible !important;
        height: auto !important;
      }
      .no-print { display: none !important; }
    }
    
    /* Modern Loader (Minimalist Spinner) */
    .modern-loader {
      width: 48px;
      height: 48px;
      border: 4px solid #e2e8f0;
      border-bottom-color: #2563eb;
      border-radius: 50%;
      display: inline-block;
      box-sizing: border-box;
      animation: rotation 1s linear infinite;
    }
    @keyframes rotation {
      0% { transform: rotate(0deg); }
      100% { transform: rotate(360deg); }
    }
  </style>
</head>
<body class="bg-slate-50 text-slate-800 font-sans antialiased">

  <!-- GLOBAL LOADING OVERLAY -->
  <div id="global-loader" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 hidden flex items-center justify-center transition-all duration-300">
    <span class="modern-loader"></span>
  </div>

  <!-- TOAST NOTIFICATION -->
  <div id="toast" class="fixed bottom-5 right-5 z-50 transform transition-all duration-300 translate-y-20 opacity-0 bg-slate-900 text-white px-5 py-3 rounded-lg shadow-xl flex items-center gap-3">
    <span id="toast-msg" class="text-sm font-medium">Notifikasi</span>
  </div>

  <!-- ==================== 1. HALAMAN LOGIN ==================== -->
  <div id="login-screen" class="min-h-screen flex items-center justify-center bg-gradient-to-br from-blue-900 via-indigo-900 to-slate-900 p-4">
    <div class="bg-white rounded-2xl shadow-2xl max-w-md w-full p-8">
      <div class="text-center mb-6">
        <div class="inline-flex items-center justify-center w-14 h-14 rounded-xl bg-blue-600 text-white mb-3 shadow-lg">
          <i data-lucide="bar-chart-3" class="w-8 h-8"></i>
        </div>
        <h2 class="text-2xl font-bold text-slate-900">MyKinerja Cloud</h2>
        <p class="text-sm text-slate-500">Sistem Manajemen Kinerja & KPI</p>
      </div>
      
      <form id="login-form" onsubmit="handleLogin(event)" class="space-y-4">
        <div>
          <label class="block text-sm font-medium text-slate-700 mb-1">ID Karyawan</label>
          <input type="text" id="login-id" required placeholder="Contoh: EMP001" class="w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:ring-2 focus:ring-blue-600 focus:border-blue-600 outline-none">
        </div>
        <div>
          <label class="block text-sm font-medium text-slate-700 mb-1">Password</label>
          <input type="password" id="login-pass" required placeholder="••••••••" class="w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:ring-2 focus:ring-blue-600 focus:border-blue-600 outline-none">
        </div>
        <button type="submit" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2.5 rounded-lg shadow transition flex items-center justify-center gap-2">
          <span>Masuk ke Portal</span>
          <i data-lucide="arrow-right" class="w-4 h-4"></i>
        </button>
      </form>
    </div>
  </div>

  <!-- ==================== MODAL KONFIRMASI KUSTOM ==================== -->
  <div id="modal-confirm" class="fixed inset-0 bg-slate-900/50 z-50 hidden flex items-center justify-center p-4">
    <div class="bg-white rounded-xl shadow-xl max-w-sm w-full p-6 space-y-4">
      <div class="flex items-center gap-3 text-amber-600">
        <i data-lucide="alert-triangle" class="w-6 h-6"></i>
        <h3 class="font-bold text-lg text-slate-900">Konfirmasi Tindakan</h3>
      </div>
      <p id="confirm-msg" class="text-sm text-slate-600">Apakah Anda yakin ingin melanjutkan?</p>
      <div class="flex justify-end gap-2 pt-2">
        <button id="confirm-cancel-btn" class="px-4 py-2 rounded-lg text-sm font-medium text-slate-600 hover:bg-slate-100">Batal</button>
        <button id="confirm-ok-btn" class="px-4 py-2 rounded-lg text-sm font-medium bg-red-600 hover:bg-red-700 text-white">Ya, Lanjutkan</button>
      </div>
    </div>
  </div>

  <!-- ==================== APP SHELL (DASHBOARD UTAMA) ==================== -->
  <div id="app-shell" class="hidden min-h-screen flex bg-slate-50">
    
    <!-- SIDEBAR -->
    <aside id="sidebar-nav" class="w-64 bg-slate-900 text-slate-300 flex-shrink-0 hidden md:flex flex-col h-screen sticky top-0 z-40">
      <div class="p-5 flex items-center gap-3 border-b border-slate-800">
        <div class="bg-blue-600 p-2 rounded-lg text-white"><i data-lucide="bar-chart-3" class="w-5 h-5"></i></div>
        <h2 class="font-bold text-white text-lg tracking-wide">MyKinerja</h2>
      </div>
      <div class="p-4 border-b border-slate-800 flex items-center gap-3">
        <div class="w-10 h-10 rounded-full bg-slate-700 flex items-center justify-center text-white font-bold"><i data-lucide="user" class="w-5 h-5"></i></div>
        <div>
          <p id="nav-user-name" class="font-medium text-white text-sm">Nama User</p>
          <p id="nav-user-role" class="text-xs text-slate-400">Role • Divisi</p>
        </div>
      </div>
      <nav class="flex-1 p-3 space-y-1 overflow-y-auto">
        <button data-tab="dashboard" onclick="switchTab('dashboard')" class="nav-btn w-full flex items-center gap-3 px-3 py-2.5 rounded-lg bg-blue-600 text-white text-sm font-medium transition">
          <i data-lucide="layout-dashboard" class="w-5 h-5"></i> Dashboard
        </button>
        <button data-tab="kpi" onclick="switchTab('kpi')" class="nav-btn w-full flex items-center gap-3 px-3 py-2.5 rounded-lg hover:bg-slate-800 text-sm font-medium transition">
          <i data-lucide="target" class="w-5 h-5"></i> Target & Katalog KPI
        </button>
        <button data-tab="realisasi" onclick="switchTab('realisasi')" class="nav-btn w-full flex items-center gap-3 px-3 py-2.5 rounded-lg hover:bg-slate-800 text-sm font-medium transition">
          <i data-lucide="check-square" class="w-5 h-5"></i> Realisasi & Aktivitas
        </button>
        <button data-tab="kompetensi" onclick="switchTab('kompetensi')" class="nav-btn role-mgr w-full flex items-center gap-3 px-3 py-2.5 rounded-lg hover:bg-slate-800 text-sm font-medium transition">
          <i data-lucide="star" class="w-5 h-5"></i> Nilai Kompetensi
        </button>
        <button data-tab="laporan" onclick="switchTab('laporan')" class="nav-btn role-mgr w-full flex items-center gap-3 px-3 py-2.5 rounded-lg hover:bg-slate-800 text-sm font-medium transition">
          <i data-lucide="send" class="w-5 h-5"></i> Kirim Laporan Massal
        </button>
        <button data-tab="users" onclick="switchTab('users')" class="nav-btn role-admin w-full flex items-center gap-3 px-3 py-2.5 rounded-lg hover:bg-slate-800 text-sm font-medium transition">
          <i data-lucide="users" class="w-5 h-5"></i> Manajemen Pengguna
        </button>
        <button data-tab="settings" onclick="switchTab('settings')" class="nav-btn role-admin w-full flex items-center gap-3 px-3 py-2.5 rounded-lg hover:bg-slate-800 text-sm font-medium transition">
          <i data-lucide="settings" class="w-5 h-5"></i> Pengaturan API
        </button>
      </nav>
      <div class="p-4 border-t border-slate-800">
        <button onclick="logout()" class="w-full flex items-center justify-center gap-2 px-4 py-2 rounded-lg bg-slate-800 hover:bg-red-600 hover:text-white text-sm font-medium transition">
          <i data-lucide="log-out" class="w-4 h-4"></i> Keluar
        </button>
      </div>
    </aside>

    <!-- MAIN CONTENT -->
    <main class="flex-1 flex flex-col h-screen overflow-hidden">
      <!-- TOPBAR MOBILE -->
      <header class="bg-white border-b border-slate-200 px-4 py-3 flex items-center justify-between md:hidden z-30">
        <div class="flex items-center gap-2 text-blue-700 font-bold">
          <i data-lucide="bar-chart-3" class="w-6 h-6"></i> MyKinerja
        </div>
        <button onclick="toggleMobileMenu()" class="text-slate-600 hover:text-slate-900"><i data-lucide="menu" class="w-6 h-6"></i></button>
      </header>

      <!-- CONTENT AREA -->
      <div class="flex-1 overflow-y-auto p-4 md:p-6 pb-20">
        
        <!-- DASHBOARD TAB -->
        <section id="tab-dashboard" class="tab-section space-y-6">
          <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 bg-white p-4 rounded-xl shadow-sm border border-slate-100">
            <div>
              <h2 class="text-xl font-bold text-slate-800">Dashboard Kinerja</h2>
              <p class="text-sm text-slate-500">Analitik performa individu dan divisi.</p>
            </div>
            <div class="flex flex-wrap gap-2 items-center">
              <select id="filter-range" onchange="handleFilterChange()" class="text-sm border border-slate-300 rounded-lg px-3 py-2 bg-slate-50 outline-none">
                <option value="Harian">Harian</option>
                <option value="Mingguan">Mingguan</option>
                <option value="Bulanan" selected>Bulanan</option>
                <option value="Tahunan">Tahunan</option>
              </select>
              <select id="filter-divisi" onchange="handleFilterChange()" class="text-sm border border-slate-300 rounded-lg px-3 py-2 bg-slate-50 outline-none"></select>
              <select id="filter-karyawan" onchange="handleFilterChange()" class="text-sm border border-slate-300 rounded-lg px-3 py-2 bg-slate-50 outline-none"></select>
              <button id="btn-toggle-dash" onclick="toggleDashboardData()" class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg text-sm font-medium transition shadow-sm flex items-center gap-2">
                <i data-lucide="eye" class="w-4 h-4"></i> Tampilkan
              </button>
            </div>
          </div>

          <div id="dashboard-content" class="hidden space-y-6">
            <!-- SUMMARY CARDS -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
              <div class="bg-white rounded-xl shadow-sm border border-slate-100 p-5 flex items-center gap-4">
                <div class="flex items-end gap-2">
                  <h3 id="stat-overall" class="text-2xl font-bold text-slate-800">0%</h3>
                  <span id="stat-overall-badge" class="mb-1"></span>
                </div>
              </div>
            </div>
            <div class="bg-white rounded-xl shadow-sm border border-slate-100 p-5 flex items-center gap-4">
              <div class="w-12 h-12 rounded-full bg-indigo-100 text-indigo-600 flex items-center justify-center"><i data-lucide="users" class="w-6 h-6"></i></div>
              <div>
                <p class="text-sm text-slate-500 font-medium">Karyawan Dievaluasi</p>
                <h3 id="stat-emp-count" class="text-2xl font-bold text-slate-800">0</h3>
              </div>
            </div>
            <div class="bg-white rounded-xl shadow-sm border border-slate-100 p-5 flex items-center gap-4">
              <div class="w-12 h-12 rounded-full bg-emerald-100 text-emerald-600 flex items-center justify-center"><i data-lucide="calendar" class="w-6 h-6"></i></div>
              <div>
                <p class="text-sm text-slate-500 font-medium">Periode Filter</p>
                <h3 id="stat-periode" class="text-xl font-bold text-slate-800">-</h3>
              </div>
            </div>
          </div>

          <!-- CHARTS -->
          <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            <div class="bg-white rounded-xl shadow-sm border border-slate-100 p-5 lg:col-span-2">
              <h3 class="text-sm font-bold text-slate-700 mb-4">Perbandingan Skor Individu</h3>
              <div class="h-64"><canvas id="chart-individu"></canvas></div>
            </div>
            <div class="bg-white rounded-xl shadow-sm border border-slate-100 p-5">
              <h3 class="text-sm font-bold text-slate-700 mb-4">Rata-Rata per Divisi</h3>
              <div class="h-64"><canvas id="chart-divisi"></canvas></div>
            </div>
          </div>

          <!-- TABLE RAPOR -->
          <div class="bg-white rounded-xl shadow-sm border border-slate-100 overflow-hidden">
            <div class="p-4 border-b border-slate-100"><h3 class="text-sm font-bold text-slate-700">Detail Rapor Karyawan</h3></div>
            <div class="overflow-x-auto">
              <table class="w-full text-sm text-left whitespace-nowrap">
                <thead class="bg-slate-50 text-slate-600 font-medium border-b border-slate-200">
                  <tr>
                    <th class="p-3.5">Karyawan</th>
                    <th class="p-3.5">Divisi</th>
                    <th class="p-3.5 text-center">Skor KPI</th>
                    <th class="p-3.5 text-center">Skor Kompetensi</th>
                    <th class="p-3.5 text-center text-blue-700">Skor Akhir</th>
                    <th class="p-3.5 text-center">Status</th>
                    <th class="p-3.5 text-right">Aksi & Kirim Rapor</th>
                  </tr>
                </thead>
                <tbody id="table-rapor-body" class="divide-y divide-slate-100"></tbody>
              </table>
            </div>
          </div>
          </div>
        </section>

        <!-- KPI & KATALOG TAB -->
        <section id="tab-kpi" class="tab-section hidden space-y-6">
          <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            <!-- FORM SET KPI -->
            <div class="bg-white rounded-xl shadow-sm border border-slate-100 p-5 role-mgr lg:col-span-1">
              <h3 class="text-sm font-bold text-slate-700 mb-4">Tetapkan Target KPI Baru</h3>
              <form id="form-kpi" onsubmit="submitMasterKPI(event)" class="space-y-3 text-sm">
                <div>
                  <label class="block text-slate-600 mb-1">Karyawan</label>
                  <select id="kpi-emp-select" required class="w-full border border-slate-300 rounded p-2"></select>
                </div>
                <div>
                  <label class="block text-slate-600 mb-1">Indikator KPI</label>
                  <input type="text" id="kpi-indikator" required class="w-full border border-slate-300 rounded p-2">
                </div>
                <div class="grid grid-cols-2 gap-3">
                  <div>
                    <label class="block text-slate-600 mb-1">Kategori</label>
                    <select id="kpi-kategori" class="w-full border border-slate-300 rounded p-2">
                      <option>Financial (BSC)</option>
                      <option>Customer (BSC)</option>
                      <option>Internal Process (BSC)</option>
                      <option>Learning & Growth (BSC)</option>
                      <option>OKR</option>
                    </select>
                  </div>
                  <div>
                    <label class="block text-slate-600 mb-1">Polaritas</label>
                    <select id="kpi-polaritas" class="w-full border border-slate-300 rounded p-2">
                      <option value="Maximize">Maximize (Makin besar bagus)</option>
                      <option value="Minimize">Minimize (Makin kecil bagus)</option>
                    </select>
                  </div>
                </div>
                <div class="grid grid-cols-3 gap-3">
                  <div><label class="block text-slate-600 mb-1">Bobot %</label><input type="number" id="kpi-bobot" required class="w-full border border-slate-300 rounded p-2"></div>
                  <div><label class="block text-slate-600 mb-1">Target</label><input type="number" step="0.01" id="kpi-target" required class="w-full border border-slate-300 rounded p-2"></div>
                  <div><label class="block text-slate-600 mb-1">Satuan</label><input type="text" id="kpi-satuan" required class="w-full border border-slate-300 rounded p-2"></div>
                </div>
                <button type="submit" class="w-full bg-blue-600 text-white rounded p-2 font-medium mt-2">Simpan KPI</button>
              </form>
            </div>

            <!-- TABEL MASTER KPI & KATALOG -->
            <div class="lg:col-span-2 space-y-6">
              <div class="bg-white rounded-xl shadow-sm border border-slate-100 overflow-hidden">
                <div class="p-4 border-b border-slate-100 bg-indigo-50"><h3 class="text-sm font-bold text-indigo-900"><i data-lucide="book-open" class="w-4 h-4 inline-block mr-1"></i> Katalog Template KPI</h3></div>
                <div class="overflow-x-auto max-h-64">
                  <table class="w-full text-xs text-left whitespace-nowrap">
                    <thead class="bg-slate-50 text-slate-600 sticky top-0 border-b border-slate-200">
                      <tr><th class="p-2">Divisi</th><th class="p-2">Indikator</th><th class="p-2">Kategori</th><th class="p-2">Target</th><th class="p-2">Bobot</th><th class="p-2 text-right role-mgr">Aksi</th></tr>
                    </thead>
                    <tbody id="table-katalog-body" class="divide-y divide-slate-100"></tbody>
                  </table>
                </div>
              </div>

              <div class="bg-white rounded-xl shadow-sm border border-slate-100 overflow-hidden">
                <div class="p-4 border-b border-slate-100"><h3 class="text-sm font-bold text-slate-700">Daftar Target KPI Aktif</h3></div>
                <div class="overflow-x-auto">
                  <table class="w-full text-xs text-left whitespace-nowrap">
                    <thead class="bg-slate-50 text-slate-600 border-b border-slate-200">
                      <tr><th class="p-3">Karyawan</th><th class="p-3">Indikator KPI</th><th class="p-3">Kategori</th><th class="p-3 text-center">Bobot</th><th class="p-3 text-center">Target</th><th class="p-3 text-center">Polaritas</th><th class="p-3 text-right role-mgr">Aksi</th></tr>
                    </thead>
                    <tbody id="table-master-kpi-body" class="divide-y divide-slate-100"></tbody>
                  </table>
                </div>
              </div>
            </div>
          </div>
        </section>

        <!-- REALISASI & ACTIVITY TAB -->
        <section id="tab-realisasi" class="tab-section hidden space-y-6">
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
            <!-- Form Realisasi -->
            <div class="bg-white rounded-xl shadow-sm border border-slate-100 p-5">
              <h3 class="text-sm font-bold text-slate-700 mb-4">Input Realisasi Kerja</h3>
              <form onsubmit="submitRealisasi(event)" class="space-y-3 text-sm">
                <div class="grid grid-cols-2 gap-3">
                  <div><label class="block text-slate-600 mb-1">Tanggal</label><input type="date" id="real-tanggal" required class="w-full border border-slate-300 rounded p-2"></div>
                  <div><label class="block text-slate-600 mb-1">Nilai Realisasi Angka</label><input type="number" step="0.01" id="real-nilai" required class="w-full border border-slate-300 rounded p-2"></div>
                </div>
                <div><label class="block text-slate-600 mb-1">Pilih KPI</label><select id="real-kpi-select" required class="w-full border border-slate-300 rounded p-2"></select></div>
                <div><label class="block text-slate-600 mb-1">Link Bukti (G-Drive/URL)</label><input type="url" id="real-bukti" placeholder="https://" class="w-full border border-slate-300 rounded p-2"></div>
                <div><label class="block text-slate-600 mb-1">Catatan</label><input type="text" id="real-catatan" class="w-full border border-slate-300 rounded p-2"></div>
                <button type="submit" class="w-full bg-emerald-600 text-white rounded p-2 font-medium">Kirim Laporan</button>
              </form>
            </div>
            <!-- Form Activity Plan -->
            <div class="bg-white rounded-xl shadow-sm border border-slate-100 p-5">
              <h3 class="text-sm font-bold text-slate-700 mb-4">Tambah Activity Plan (To-Do)</h3>
              <form onsubmit="submitActivity(event)" class="space-y-3 text-sm">
                <div><label class="block text-slate-600 mb-1">Rencana Aktivitas / Tugas</label><input type="text" id="act-rencana" required class="w-full border border-slate-300 rounded p-2"></div>
                <div class="grid grid-cols-2 gap-3">
                  <div><label class="block text-slate-600 mb-1">Tenggat Waktu</label><input type="date" id="act-tenggat" required class="w-full border border-slate-300 rounded p-2"></div>
                  <div><label class="block text-slate-600 mb-1">Prioritas</label><select id="act-prioritas" class="w-full border border-slate-300 rounded p-2"><option>High</option><option selected>Medium</option><option>Low</option></select></div>
                </div>
                <button type="submit" class="w-full bg-indigo-600 text-white rounded p-2 font-medium mt-2">Tambah Plan</button>
              </form>
            </div>
          </div>

          <!-- Tabel Realisasi -->
          <div class="bg-white rounded-xl shadow-sm border border-slate-100 overflow-hidden mt-6">
            <div class="p-4 border-b border-slate-100"><h3 class="text-sm font-bold text-slate-700">Log Realisasi Kerja</h3></div>
            <div class="overflow-x-auto">
              <table class="w-full text-sm text-left whitespace-nowrap">
                <thead class="bg-slate-50 text-slate-600 border-b border-slate-200">
                  <tr><th class="p-3">Tgl</th><th class="p-3">Karyawan</th><th class="p-3">Indikator KPI</th><th class="p-3 text-center">Capaian</th><th class="p-3">Bukti & Catatan</th><th class="p-3 text-center">Status</th><th class="p-3 text-right">Validasi</th></tr>
                </thead>
                <tbody id="table-realisasi-body" class="divide-y divide-slate-100"></tbody>
              </table>
            </div>
          </div>

          <!-- Tabel Activity Plan -->
          <div class="bg-white rounded-xl shadow-sm border border-slate-100 overflow-hidden mt-6">
            <div class="p-4 border-b border-slate-100"><h3 class="text-sm font-bold text-slate-700">Daftar Activity Plan</h3></div>
            <div class="overflow-x-auto">
              <table class="w-full text-sm text-left whitespace-nowrap">
                <thead class="bg-slate-50 text-slate-600 border-b border-slate-200">
                  <tr><th class="p-3">Karyawan</th><th class="p-3">Rencana Aktivitas</th><th class="p-3">Tenggat</th><th class="p-3">Prioritas</th><th class="p-3">Status Karyawan</th><th class="p-3">Approval Atasan</th></tr>
                </thead>
                <tbody id="table-activity-body" class="divide-y divide-slate-100"></tbody>
              </table>
            </div>
          </div>
        </section>

        <!-- KOMPETENSI TAB -->
        <section id="tab-kompetensi" class="tab-section hidden space-y-6">
